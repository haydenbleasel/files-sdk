{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No `rootDir`: the published build is produced by scripts/build.ts (Bun
    // for .js + tsc for .d.ts, via tsconfig.build.json). This config is only
    // used for `tsc --noEmit` typechecking, which covers `test/**` and the
    // build scripts too. Setting `rootDir: "src"` made the typecheck fail every
    // non-src file with TS6059 ("not under rootDir").
    "outDir": "dist",
    // Not `@cloudflare/workers-types`: its ambient `index.d.ts` declares
    // global `Buffer: any` / `process: any` (since 5.20260907), which would
    // shadow @types/node's Buffer everywhere. The r2 adapter imports the R2
    // types it needs explicitly, which resolves to the package's ES module
    // (`index.ts`) and never loads the globals.
    "types": ["bun"],
    "strictNullChecks": true
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*"]
}
