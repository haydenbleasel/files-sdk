# Cloudflare redirects (Workers static assets / Pages). Blume ships this file
# as-is because it's in public/; keep every redirect here.
#
# Rules match top-down and a redirect fires even when an asset exists at the
# source path, so anything served under a legacy prefix must be carved out
# above that prefix's wildcard.

# Blume's JSON docs API (/api/docs/pages.json, /api/docs/navigation.json, …) is
# advertised by openapi.json, .well-known/api-catalog and llms.txt. Serve it
# in place (a same-path 200 proxy) before the legacy /api/* rule below can
# redirect it to /docs/api/docs/… (a 404).
/api/docs/* /api/docs/:splat 200

# Old root URLs → /docs/*
/adapters /docs/adapters 301
/adapters/* /docs/adapters/:splat 301
/ai /docs/ai 301
/ai/* /docs/ai/:splat 301
/api /docs/api 301
/api/* /docs/api/:splat 301
/cli /docs/cli 301
/cli/* /docs/cli/:splat 301
