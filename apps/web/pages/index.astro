---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

import Adapters from "@/components/home/adapters.astro";
import FinalCta from "@/components/home/final-cta.astro";
import Footer from "@/components/home/footer.astro";
import Hero from "@/components/home/hero.astro";
import Plugins from "@/components/home/plugins.astro";
import Principles from "@/components/home/principles.astro";
import Sponsors from "@/components/home/sponsors.astro";
import WaysIn from "@/components/home/ways-in.astro";
import { ADAPTERS } from "@/lib/adapters";
import { PLUGINS } from "@/lib/plugins";
import { getLatestVersion } from "@/lib/version";

const { config } = data;
const latestVersion = getLatestVersion();
const adapterCount = ADAPTERS.length;
const pluginCount = PLUGINS.length;
---

<PageLayout
  analytics={config.analytics}
  appleIcon={config.appleIcon}
  banner={config.banner}
  clientData={{
    config: data.config,
    navigation: data.navigation,
    page: { route: "/", title: "Home" },
  }}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{
    description: `Write once, store anywhere: one small, honest API for S3, R2, Vercel Blob, GCS, Azure, and ${adapterCount - 5} more object and blob stores, with web-standard I/O and a typed escape hatch.`,
    title: "Files SDK — Write once. Store anywhere.",
  }}
  searchEnabled={config.search.enabled}
  site={{ title: config.title, description: config.description }}
  siteUrl={config.site}
  themeMode={config.theme.mode}
  ui={data.ui}
>
  <div class="isolate" data-home>
    <Hero
      adapterCount={adapterCount}
      latestVersion={latestVersion}
      pluginCount={pluginCount}
    />
    <Adapters />
    <WaysIn adapterCount={adapterCount} pluginCount={pluginCount} />
    <Plugins />
    <Principles />
    <Sponsors />
    <FinalCta />
  </div>
  <Footer slot="footer" />
</PageLayout>

<script>
  // Scroll reveals (theme.css, `[data-reveal]`): a block still below the
  // fold is marked pending (hidden) and plays once as it comes into view.
  // Anything already on screen is left alone, and without this script nothing
  // is ever hidden. Rebound after client-router swaps.
  const bind = () => {
    const blocks = document.querySelectorAll<HTMLElement>(
      "[data-reveal]:not([data-reveal-bound])"
    );
    if (blocks.length === 0 || !("IntersectionObserver" in window)) {
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.target instanceof HTMLElement) {
            entry.target.dataset.reveal = "done";
            observer.unobserve(entry.target);
          }
        }
      },
      // Play as the block arrives, a little before it's fully in view.
      { rootMargin: "0px 0px -10% 0px" }
    );
    for (const block of blocks) {
      block.dataset.revealBound = "";
      if (block.getBoundingClientRect().top < window.innerHeight * 0.9) {
        continue;
      }
      block.dataset.reveal = "pending";
      observer.observe(block);
    }
  };
  document.addEventListener("astro:page-load", bind);
</script>
