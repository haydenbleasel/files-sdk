---
import Icon from "blume/components/Icon.astro";

interface Props {
  command?: string;
  class?: string;
}

const { command = "npm i files-sdk", class: className } = Astro.props;
---

<button
  aria-label={`Copy install command: ${command}`}
  class:list={[
    "inline-flex h-12 cursor-pointer items-center gap-3 border border-neutral-950/15 bg-transparent pr-4 pl-5 font-mono transition-[border-color,scale] duration-150 ease-out active:scale-[0.97] text-base text-neutral-950 hover:border-neutral-950/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-950 sm:text-[0.9375rem] dark:border-white/15 dark:text-white dark:hover:border-white/30 dark:focus-visible:outline-white",
    className,
  ]}
  data-command={command}
  data-install-command
  type="button"
>
  <span class="text-neutral-500 dark:text-neutral-400">$</span>
  <span>{command}</span>
  <span class="grid size-4 shrink-0 *:[grid-area:1/1]">
    <Icon
      class="copy-icon size-4 text-neutral-500 dark:text-neutral-400"
      name="copy"
    />
    <Icon class="check-icon size-4" name="check" />
  </span>
</button>

<script>
  import { track } from "blume/components/layout/analytics-client.ts";

  // Bundled module scripts run once per full page load, but Blume's layouts
  // use Astro's <ClientRouter />: navigating back to "/" swaps in fresh
  // buttons without re-running this module. `astro:page-load` fires on the
  // initial load and after every client-side navigation, so bind there (and
  // mark each button so a persisted one is never bound twice).
  const bind = () => {
    for (const btn of document.querySelectorAll<HTMLButtonElement>(
      "[data-install-command]:not([data-bound])"
    )) {
      btn.dataset.bound = "";
      let timer: ReturnType<typeof setTimeout>;
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.command ?? "");
        } catch {
          // Clipboard access can be blocked; leave the copy icon in place
          // rather than claim a copy that didn't happen.
          return;
        }
        track("install_copy", {
          manager: (btn.dataset.command ?? "").split(" ")[0] ?? "",
          page: location.pathname,
        });
        // The icons crossfade on `data-copied` (theme.css).
        btn.dataset.copied = "";
        clearTimeout(timer);
        timer = setTimeout(() => {
          delete btn.dataset.copied;
        }, 1800);
      });
    }
  };

  document.addEventListener("astro:page-load", bind);
</script>
