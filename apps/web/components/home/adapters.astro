---
import Icon from "blume/components/Icon.astro";

import { ADAPTERS } from "@/lib/adapters";
import { RECOMMENDED_PROVIDERS, SPONSORS_URL } from "@/lib/recommended";
import ProviderMark from "../provider-mark.astro";

// Every adapter in the SDK's provider catalog, alphabetically by display name.
// Each slug is also its docs page (`/docs/adapters/<slug>`). Providers whose
// company sponsors Files SDK get their own, larger list above the rest.
const adapters = ADAPTERS.toSorted((a, b) =>
  a.name.localeCompare(b.name, "en", { sensitivity: "base" })
);
const recommended = adapters.filter((adapter) =>
  RECOMMENDED_PROVIDERS.has(adapter.slug)
);
const others = adapters.filter(
  (adapter) => !RECOMMENDED_PROVIDERS.has(adapter.slug)
);

const ROW =
  "group -mx-2 flex items-center justify-between gap-4 px-2 hover:bg-highlighter hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-neutral-950 dark:focus-visible:outline-white";
const INK = "text-neutral-950 dark:text-white";
const SLUG =
  "shrink-0 font-mono text-[0.8125rem]/6 text-neutral-500 group-hover:text-neutral-700";
---

<section class="border-t border-neutral-950/5 dark:border-white/10">
  <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-6">
      <div>
        <h2
          class="max-w-[30ch] font-display text-4xl font-semibold tracking-tight text-balance text-neutral-950 sm:text-5xl dark:text-white"
        >
          {adapters.length} backends. One shape.
        </h2>
        <p
          class="mt-6 max-w-[60ch] text-lg/8 text-pretty text-neutral-600 dark:text-neutral-400"
        >
          Each adapter is its own subpath export, and each provider's SDK is an
          optional peer. The ones you never import are never bundled.
        </p>
      </div>
      <a
        class="inline-flex items-center gap-1.5 text-base font-semibold text-neutral-950 hover:underline hover:underline-offset-4 dark:text-white"
        href="/docs/adapters"
      >
        Browse every adapter
        <Icon class="size-4 shrink-0" name="arrow-right" />
      </a>
    </div>

    <div class="mt-16">
      <h3
        class="font-display text-xl font-semibold tracking-tight text-neutral-950 dark:text-white"
      >
        Recommended adapters
      </h3>
      <p
        class="mt-2 max-w-[72ch] text-base/7 text-pretty text-neutral-600 sm:text-sm/6 dark:text-neutral-400"
      >
        These providers help maintain Files SDK by sponsoring its development.
      </p>
      <ul class="mt-4 grid gap-x-8 sm:grid-cols-2" role="list">
        {
          recommended.map((adapter) => (
            <li class="border-b border-neutral-950/10 dark:border-white/10">
              <a class:list={[ROW, INK, "py-5"]} href={`/docs/adapters/${adapter.slug}`}>
                <span class="flex min-w-0 items-center gap-4">
                  <ProviderMark class="size-8" slug={adapter.slug} />
                  <span class="min-w-0 truncate font-display text-2xl font-semibold tracking-tight">
                    {adapter.name}
                  </span>
                </span>
                <span class={SLUG}>{adapter.slug}</span>
              </a>
            </li>
          ))
        }
        <li class="border-b border-neutral-950/10 dark:border-white/10">
          <a
            class:list={[
              ROW,
              "py-5 text-neutral-500 dark:text-neutral-400",
            ]}
            href={SPONSORS_URL}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span class="flex min-w-0 items-center gap-4">
              <span
                aria-hidden="true"
                class="flex size-8 shrink-0 items-center justify-center border border-dashed border-current"
              >
                <Icon class="size-4" name="plus" />
              </span>
              <span
                class="min-w-0 truncate font-display text-2xl font-semibold tracking-tight"
              >
                Become a recommended adapter
              </span>
            </span>
            <Icon
              class="size-5 shrink-0 text-neutral-500 group-hover:text-neutral-700"
              name="arrow-up-right"
            />
          </a>
        </li>
      </ul>
    </div>

    <div class="mt-16">
      <h3
        class="font-display text-xl font-semibold tracking-tight text-neutral-950 dark:text-white"
      >
        Other adapters
      </h3>
      <ul class="mt-4 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {
          others.map((adapter) => (
            <li class="border-b border-neutral-950/10 dark:border-white/10">
              <a class:list={[ROW, INK, "py-3"]} href={`/docs/adapters/${adapter.slug}`}>
                <span class="flex min-w-0 items-center gap-3">
                  <ProviderMark class="size-5" slug={adapter.slug} />
                  <span class="min-w-0 truncate text-base/6">{adapter.name}</span>
                </span>
                <span class:list={[SLUG, "max-xl:hidden"]}>{adapter.slug}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
