---
import Icon from "blume/components/Icon.astro";

import { PLUGINS } from "@/lib/plugins";
import CodeBlock from "./code-block.astro";

const SNIPPET = `import { Files } from "files-sdk";
import { s3 } from "files-sdk/s3";
import { compression } from "files-sdk/compression";
import { encryption } from "files-sdk/encryption";
import { validation } from "files-sdk/validation";

const files = new Files({
  adapter: s3({ bucket: "uploads" }),
  plugins: [
    validation({ allowedTypes: ["image/*"] }),
    compression(),
    encryption(key),
  ],
});`;

// Outermost first, as in `plugins`. A write runs inward through each layer to
// the adapter; a read unwinds back out in reverse.
const LAYERS = [
  {
    fill: "bg-coral/15 dark:bg-coral/10",
    name: "validation()",
    role: "Rejects bad writes",
  },
  {
    fill: "bg-coral/25 dark:bg-coral/15",
    name: "compression()",
    role: "Shrinks bodies at rest",
  },
  {
    fill: "bg-coral/40 dark:bg-coral/20",
    name: "encryption(key)",
    role: "Seals bodies at rest",
  },
];
---

<section class="border-t border-neutral-950/5 dark:border-white/10">
  <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8">
    <div class="grid gap-x-8 gap-y-16 lg:grid-cols-12">
      <div class="min-w-0 lg:sticky lg:top-24 lg:col-span-5 lg:self-start">
        <p
          class="font-mono text-sm/6 tracking-wide text-neutral-600 uppercase dark:text-neutral-400"
        >
          Plugins
        </p>
        <h2
          class="mt-4 max-w-[30ch] font-display text-4xl font-semibold tracking-tight text-balance text-neutral-950 sm:text-5xl dark:text-white"
        >
          Layer on what your storage is missing.
        </h2>
        <p
          class="mt-6 max-w-[48ch] text-lg/8 text-pretty text-neutral-600 dark:text-neutral-400"
        >
          Plugins wrap every operation in an ordered pipeline to transform it,
          veto it, or watch it go by. Writes run inward, and reads unwind in
          reverse on their own.
        </p>
        <a
          class="mt-8 inline-flex items-center gap-1.5 text-base font-semibold text-neutral-950 hover:underline hover:underline-offset-4 dark:text-white"
          href="/docs/plugins"
        >
          How plugins compose
          <Icon class="size-4 shrink-0" name="arrow-right" />
        </a>

        <figure class="mt-12">
          <div
            class:list={[
              "dog-ear border border-neutral-950/15 p-4 [--fold-color:var(--color-coral)] [--fold:--spacing(5)] sm:p-5 dark:border-white/15",
              LAYERS[0].fill,
            ]}
          >
            <p class="font-mono text-sm/6 text-neutral-950 dark:text-white">
              {LAYERS[0].name}{" "}<span class="text-neutral-600 dark:text-neutral-400">· {LAYERS[0].role}</span>
            </p>
            <div
              class:list={[
                "dog-ear mt-4 border border-neutral-950/15 p-4 [--fold-color:var(--color-coral)] [--fold:--spacing(5)] sm:p-5 dark:border-white/15",
                LAYERS[1].fill,
              ]}
            >
              <p class="font-mono text-sm/6 text-neutral-950 dark:text-white">
                {LAYERS[1].name}{" "}<span class="text-neutral-600 dark:text-neutral-400">· {LAYERS[1].role}</span>
              </p>
              <div
                class:list={[
                  "dog-ear mt-4 border border-neutral-950/15 p-4 [--fold-color:var(--color-coral)] [--fold:--spacing(5)] sm:p-5 dark:border-white/15",
                  LAYERS[2].fill,
                ]}
              >
                <p class="font-mono text-sm/6 text-neutral-950 dark:text-white">
                  {LAYERS[2].name}{" "}<span class="text-neutral-600 dark:text-neutral-400">· {LAYERS[2].role}</span>
                </p>
                <p
                  class="mt-4 bg-neutral-950 px-4 py-3 font-mono text-sm/6 text-white dark:bg-white dark:text-neutral-950"
                >
                  s3() · the real call
                </p>
              </div>
            </div>
          </div>
          <figcaption
            class="mt-5 flex flex-col gap-1 font-mono text-sm/6 text-neutral-600 dark:text-neutral-400"
          >
            <span>upload: validate → compress → encrypt → store</span>
            <span>download: fetch → decrypt → decompress → validate</span>
          </figcaption>
        </figure>
      </div>

      <div class="min-w-0 lg:col-span-7">
        <div
          class="dog-ear border border-neutral-950/15 bg-white [--fold-color:var(--color-coral)] [--fold:--spacing(8)] dark:border-white/15 dark:bg-neutral-900"
        >
          <div
            class="border-b border-neutral-950/5 py-3.5 pr-14 pl-5 font-mono text-[0.8125rem]/5 text-neutral-500 dark:border-white/10 dark:text-neutral-400"
          >
            storage.ts
          </div>
          <CodeBlock code={SNIPPET} highlight={[9, 10, 11, 12, 13]} />
        </div>

        <dl class="mt-16 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
          {
            PLUGINS.map((plugin) => (
              <div class="border-t border-neutral-950/10 pt-4 dark:border-white/10">
                <dt>
                  <a
                    class="font-mono text-base/6 text-neutral-950 hover:underline hover:underline-offset-4 sm:text-sm/6 dark:text-white"
                    href={`/docs/plugins/${plugin.slug}`}
                  >
                    {plugin.name}
                  </a>
                </dt>
                <dd class="mt-1 text-base/7 text-pretty text-neutral-600 sm:text-sm/6 dark:text-neutral-400">
                  {plugin.description}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
